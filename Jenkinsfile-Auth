// Runs authentication contract validation, code checks, coverage, database tests and builds in Jenkins.
// Also runs browser session tests; the agent needs Node.js 24+ and PostgreSQL tools.
pipeline {
    agent any
    options { timestamps() }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Angular authentication UI') {
            steps {
                dir('app/frontend/SEAJ-ui') {
                    sh 'npm ci'
                    sh 'npm test -- --watch=false'
                    sh 'npm run build'
                }
                sh 'node app/frontend/test/auth-service.test.mjs'
            }
        }
        stage('Auth contract and tests') {
            steps {
                dir('app/backend/backend-nestjs') {
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm run validate:openapi'
                    sh 'npm run lint'
                    sh 'npm run typecheck'
                    sh 'npm run test:cov -- --runInBand'
                    sh 'bash scripts/test-postgres.sh'
                    sh 'npm run build'
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'app/backend/backend-nestjs/coverage/**', allowEmptyArchive: true
        }
    }
}
