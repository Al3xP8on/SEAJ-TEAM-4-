          },
          "accountId": {
            "type": "string",
            "description": "Account ID that placed the order",
            "example": "ACC-001",
            "minLength": 1
          },
          "accountHolderName": {
            "type": "string",
            "description": "Name of the account holder",
            "example": "Alice Johnson",
            "minLength": 1
          },
          "ticker": {
            "type": "string",
            "description": "Trading symbol/instrument identifier",
            "example": "AAPL",
            "minLength": 1
          },
          "instrumentName": {
            "type": "string",
            "description": "Name of the trading instrument",
            "example": "Apple Inc.",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "description": "Number of units",
            "example": 100
          },
          "price": {
            "type": "number",
            "description": "Order price per unit",
            "example": 150.5
          },
          "totalValue": {
            "type": "number",
            "description": "Total value of the order (quantity * price)",
            "example": 15050.0
          },
          "side": {
            "type": "string",
            "description": "Order direction",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "status": {
            "type": "string",
            "description": "Current order status",
            "enum": [
              "NEW",
              "PENDING",
              "FILLED",
              "CANCELLED",
              "REJECTED"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Idempotency key for duplicate prevention",
            "example": "IDEMP-20260922-001",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Order creation timestamp",
            "example": "2026-09-22T10:15:00Z"
          },
          "orderType": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ]
          },
          "executionPrice": {
            "type": "number"
          }
        },
        "required": [
          "accountHolderName",
          "accountId",
          "createdAt",
          "idempotencyKey",
          "instrumentName",
          "orderId",
          "price",
          "quantity",
          "side",
          "status",
          "ticker",
          "totalValue"
        ]
      },
      "PriceHistoryRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "priceDate": {
            "type": "string",
            "format": "date"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "close",
          "high",
          "low",
          "open",
          "priceDate",
          "symbol"
        ]
      },
      "PriceHistoryResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "priceDate": {
            "type": "string",
            "format": "date"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "integer",
            "format": "int64"
          },
          "priceRange": {
            "type": "number"
          },
          "dailyChange": {
            "type": "number"
          },
          "dailyChangePercent": {
            "type": "number"
          }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "description": "Request to place a new order",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Account ID placing the order",
            "example": "ACC-001",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "description": "Trading symbol/instrument identifier",
            "example": "AAPL",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "description": "Order side - BUY or SELL",
            "enum": [
              "BUY",
              "SELL"
            ],
            "example": "BUY"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Number of units to order (must be positive)",
            "example": 100
          },
          "price": {
            "type": "number",
            "description": "Limit price per unit; omit for MARKET orders",
            "example": 150.5
          },
          "timeInForce": {
            "type": "string",
            "description": "Time in force; only GTC is currently supported",
            "enum": [
              "GTC",
              "GTD",
              "IOC",
              "FOK"
            ],
            "example": "GTC"
          },
          "orderType": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "accountId",
          "orderType",
          "side",
          "symbol"
        ]
      },
      "AccountInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Login username (must be unique)",
            "example": "frank",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "Password (will be hashed before storage)",
            "example": "s3cur3P@ss!",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address for registration and login verification",
            "example": "frank.smith@email.com",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "description": "Phone number",
            "example": "+44-1234-567895"
          },
          "roles": {
            "type": "string",
            "description": "Comma-separated account roles",
            "example": "USER"
          }
        },
        "required": [
          "email",
          "password",
          "username"
        ]
      },
      "CashTransactionRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
