      "EmailVerificationRequest": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}"
