        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Internal database ID",
            "example": 1
          },
          "accountId": {
            "type": "string",
            "description": "Public account identifier",
            "example": "ACC-0001",
            "minLength": 1
          },
          "holderName": {
            "type": "string",
