// Multi-branch Pipeline: Database Schema Management
// Focuses on building and deploying the modular database schema (10 separate SQL files)
pipeline {
    agent any
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }
    
    tools {
        jdk 'JDK21'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Clean Old Database Infrastructure') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME')
                    ]) {
                        withEnv([
                            "POSTGRES_DB=SEAJ_db_DEMO",
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}",
                            "DB_PORT=5432"
                        ]) {
                            echo "=========================================="
                            echo "STEP 1: Cleaning Old Database Infrastructure"
                            echo "=========================================="
                            sh '''
                                echo "Stopping and removing containers..."
                                docker-compose down --remove-orphans 2>/dev/null || true
                                docker kill seaj_postgres_db 2>/dev/null || true
                                docker rm -f seaj_postgres_db 2>/dev/null || true
                                
                                echo "Removing data volumes..."
                                docker volume rm -f pgdata_volume 2>/dev/null || true
                                
                                echo "Pruning Docker resources..."
                                docker system prune -af --volumes 2>/dev/null || true
                                
                                echo "✓ Cleanup complete"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Validate Modular Schema Files') {
            steps {
                echo "=========================================="
                echo "STEP 2: Validating Modular Schema Files"
                echo "=========================================="
                sh '''
                    echo "Checking required schema files..."
                    SCHEMA_FILES=(
                        "infra/db/tables/00-setup.sql"
                        "infra/db/tables/01-clients.sql"
                        "infra/db/tables/02-accounts.sql"
                        "infra/db/tables/03-instruments.sql"
                        "infra/db/tables/04-orders.sql"
                        "infra/db/tables/05-positions.sql"
                        "infra/db/tables/06-order_history.sql"
                        "infra/db/tables/07-price_history.sql"
                        "infra/db/tables/08-current_prices.sql"
                        "infra/db/tables/index.sql"
                    )
                    
                    MISSING_FILES=0
                    for file in "${SCHEMA_FILES[@]}"; do
                        if [ -f "$file" ]; then
                            echo "  ✓ $file"
                        else
                            echo "  ✗ MISSING: $file"
                            MISSING_FILES=$((MISSING_FILES + 1))
                        fi
                    done
                    
                    if [ $MISSING_FILES -gt 0 ]; then
                        echo "ERROR: $MISSING_FILES schema files are missing!"
                        exit 1
                    fi
                    echo "✓ All schema files present"
                '''
            }
        }
        
        stage('Build Database Image') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME')
                    ]) {
                        withEnv([
                            "POSTGRES_DB=SEAJ_db_DEMO",
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}",
                            "DB_PORT=5432"
                        ]) {
                            echo "=========================================="
                            echo "STEP 3: Building Database Image"
                            echo "=========================================="
                            sh '''
                                echo "Building PostgreSQL database image with modular schema..."
                                docker-compose build --no-cache db
                                echo "✓ Database image built successfully"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Start Database Container') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME')
                    ]) {
                        withEnv([
                            "POSTGRES_DB=SEAJ_db_DEMO",
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}",
                            "DB_PORT=5432"
                        ]) {
                            echo "=========================================="
                            echo "STEP 4: Starting Database Container"
                            echo "=========================================="
                            sh '''
                                echo "Starting PostgreSQL container..."
                                docker-compose up -d db
                                
                                echo "Waiting for database to initialize (30 seconds)..."
                                sleep 30
                                
                                echo "Checking container logs..."
                                docker-compose logs db | tail -50
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Wait for Database Ready') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME')
                    ]) {
                        withEnv([
                            "POSTGRES_DB=SEAJ_db_DEMO",
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}"
                        ]) {
                            echo "=========================================="
                            echo "STEP 5: Verifying Database Readiness"
                            echo "=========================================="
                            sh '''
                                MAX_ATTEMPTS=30
                                ATTEMPT=0
                                
                                while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
                                    if docker-compose exec -T db pg_isready -U $DB_USERNAME > /dev/null 2>&1; then
                                        echo "✓ Database is ready!"
                                        break
                                    fi
                                    ATTEMPT=$((ATTEMPT + 1))
                                    echo "  -> Waiting... (Attempt $ATTEMPT/$MAX_ATTEMPTS)"
                                    sleep 2
                                done
                                
                                if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
                                    echo "ERROR: Database failed to start"
                                    docker-compose logs db
                                    exit 1
                                fi
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Verify Schema Creation') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME')
                    ]) {
                        withEnv([
                            "POSTGRES_DB=SEAJ_db_DEMO",
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}"
                        ]) {
                            echo "=========================================="
                            echo "STEP 6: Verifying Schema"
                            echo "=========================================="
                            sh '''
                                echo "Connected databases:"
                                docker-compose exec -T db psql -U $DB_USERNAME -c "\\l"
                                
                                echo ""
                                echo "Database tables:"
                                docker-compose exec -T db psql -U $DB_USERNAME -d $POSTGRES_DB -c "\\dt"
                                
                                echo ""
                                echo "Database enums:"
                                docker-compose exec -T db psql -U $DB_USERNAME -d $POSTGRES_DB -c "SELECT typname FROM pg_type WHERE typtype = 'e';"
                                
                                echo ""
                                echo "✓ Schema verification complete"
                            '''
                        }
                    }
                }
            }
        }
    }
    
    post {
        failure {
            echo "=========================================="
            echo "DATABASE PIPELINE FAILED"
            echo "=========================================="
            sh '''
                echo "Collecting diagnostic information..."
                docker-compose logs db || true
                docker ps -a || true
            '''
        }
        success {
            echo "=========================================="
            echo "DATABASE PIPELINE SUCCESSFUL"
            echo "Modular schema is ready for integration"
            echo "=========================================="
        }
    }
}
