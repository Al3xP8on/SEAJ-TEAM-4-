// Multi-branch Pipeline: Deploy Modular Database Schema
// Simply validates the 10 modular files and deploys them
pipeline {
    agent any
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }
    
    tools {
        jdk 'JDK21'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Validate 10 Modular Schema Files') {
            steps {
                sh '''
                    echo "✓ Validating modular schema files..."
                    SCHEMA_FILES=(
                        "infra/db/tables/00-setup.sql"
                        "infra/db/tables/01-clients.sql"
                        "infra/db/tables/02-accounts.sql"
                        "infra/db/tables/03-instruments.sql"
                        "infra/db/tables/04-orders.sql"
                        "infra/db/tables/05-positions.sql"
                        "infra/db/tables/06-order_history.sql"
                        "infra/db/tables/07-price_history.sql"
                        "infra/db/tables/08-current_prices.sql"
                        "infra/db/tables/index.sql"
                    )
                    
                    for file in "${SCHEMA_FILES[@]}"; do
                        [ -f "$file" ] || { echo "MISSING: $file"; exit 1; }
                        echo "  ✓ $(basename $file)"
                    done
                    echo "✓ All 10 modular files validated"
                '''
            }
        }
        
        stage('Deploy Modular Schema') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'postgres_password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'postgres_username', variable: 'DB_USERNAME'),
                        string(credentialsId: 'postgres_db', variable: 'POSTGRES_DB')
                    ]) {
                        withEnv([
                            "POSTGRES_PASSWORD=${DB_PASSWORD}",
                            "DB_USERNAME=${DB_USERNAME}",
                            "POSTGRES_DB=${POSTGRES_DB}"
                        ]) {
                            sh '''
                                echo "=========================================="
                                echo "Deploying 10 Modular Schema Files"
                                echo "=========================================="
                                
                                echo "Cleaning old containers..."
                                docker-compose down --remove-orphans 2>/dev/null || true
                                docker volume rm -f pgdata_volume 2>/dev/null || true
                                
                                echo "Building PostgreSQL image..."
                                docker-compose build --no-cache db
                                
                                echo "Starting database container..."
                                docker-compose up -d db
                                sleep 30
                                
                                echo "Waiting for database readiness..."
                                MAX_ATTEMPTS=30
                                for ((i=1; i<=MAX_ATTEMPTS; i++)); do
                                    docker-compose exec -T db pg_isready -U $DB_USERNAME >/dev/null 2>&1 && break
                                    sleep 2
                                done
                                
                                echo "✓ Modular schema deployed"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Verify Schema Files') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "✓ Verifying 10 Modular SQL Files"
                    echo "=========================================="
                    
                    SCHEMA_FILES=(
                        "infra/db/tables/00-setup.sql"
                        "infra/db/tables/01-clients.sql"
                        "infra/db/tables/02-accounts.sql"
                        "infra/db/tables/03-instruments.sql"
                        "infra/db/tables/04-orders.sql"
                        "infra/db/tables/05-positions.sql"
                        "infra/db/tables/06-order_history.sql"
                        "infra/db/tables/07-price_history.sql"
                        "infra/db/tables/08-current_prices.sql"
                        "infra/db/tables/index.sql"
                    )
                    
                    echo ""
                    echo "File Structure:"
                    for file in "${SCHEMA_FILES[@]}"; do
                        SIZE=$(wc -l < "$file")
                        echo "  • $(basename $file) ($SIZE lines)"
                    done
                    
                    echo ""
                    echo "Layer Dependencies:"
                    echo "  Layer 1: 00-setup.sql (Extensions & Enums)"
                    echo "  Layer 2: 01-clients.sql, 02-accounts.sql, 03-instruments.sql"
                    echo "  Layer 3: 04-orders.sql, 05-positions.sql, 06-order_history.sql"
                    echo "  Layer 4: 07-price_history.sql, 08-current_prices.sql"
                    echo "  Layer 5: index.sql"
                    
                    echo ""
                    echo "✓ All 10 modular files verified"
                '''
            }
        }
    }
}