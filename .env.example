# Lists example database, JWT, SMTP and application settings for local deployment.
# Copy the required values into a private environment file and supply your own credentials.
POSTGRES_DB=SEAJ_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DB_PORT=5432
DB_HOST=REPLACE_WITH_DB_HOST_VM_IP
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=seaj_db
APP_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/SEAJ_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

JWT_SECRET=JWT_SECRET
JWT_EXPIRY=1800
JWT_REFRESH_EXPIRY=604800
EMAIL_CODE_EXPIRY=300
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=youraddress@gmail.com
# Optional comma-separated origins for separately hosted frontends.
FRONTEND_ORIGINS=

# Alpaca market data: use the API keys from your Paper Trading dashboard.
# IEX is the free feed; SIP requires the corresponding market-data subscription.
ALPACA_ENABLED=true
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex


SONAR_TOKEN=SONAR_TOKEN
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Start the observability stack with plain docker-compose up (set empty to disable)
COMPOSE_PROFILES=observability
# Send traces, metrics and logs from the Java services to the stack above (set true when it's off)
OTEL_SDK_DISABLED=false


# Read-only Alpaca Broker fixed-income catalogue (separate from stock-feed keys).
ALPACA_BROKER_ENABLED=false
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# Admin dashboard monitoring: internal Prometheus URL for the Java API.
# If Java runs outside Docker, use http://localhost:8086 instead.
OBSERVABILITY_PROMETHEUS_URL=http://prometheus:9090
# Optional public Grafana URL. Empty uses the app's hostname on port 8084.
OBSERVABILITY_GRAFANA_URL=


# Read-only Alpaca Broker fixed-income catalogue (separate from stock-feed keys).
ALPACA_BROKER_ENABLED=false
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
