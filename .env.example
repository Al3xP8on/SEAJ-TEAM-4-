# Lists example database, JWT, SMTP and application settings for local deployment.
# Copy the required values into a private environment file and supply your own credentials.
POSTGRES_DB=SEAJ_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DB_PORT=5432
DB_HOST=REPLACE_WITH_DB_HOST_VM_IP
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=seaj_db
APP_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/SEAJ_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

JWT_SECRET=JWT_SECRET
JWT_EXPIRY=1800
JWT_REFRESH_EXPIRY=604800
EMAIL_CODE_EXPIRY=300
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=youraddress@gmail.com
# Optional comma-separated origins for separately hosted frontends.
FRONTEND_ORIGINS=

ENGINE_MIN_DELAY=0ms
ENGINE_MAX_DELAY=0ms
ENGINE_MAX_PRICE_IMPROVEMENT_BPS=0

SONAR_TOKEN=SONAR_TOKEN