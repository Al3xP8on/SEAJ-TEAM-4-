// Multi-branch Pipeline: Spring Boot Application Build & Test
pipeline {
    agent any
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }
    
    tools {
        jdk 'JDK21'
        maven 'maven'
    }

    environment {
        // Scanner images and settings live in scripts/ci/*.sh; set GITLEAKS_IMAGE,
        // TRIVY_IMAGE or TRIVY_SEVERITY here to override them for CI only.
        // 'false' marks the build UNSTABLE on findings; set to 'true' to fail the build once existing findings are fixed
        ENFORCE_DEPENDENCY_SCAN = 'false'
        ENFORCE_SAST = 'false'
        REPORTS_DIR = 'security-reports'
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Secrets Scan') {
            steps {
                echo "=========================================="
                echo "Scanning for hardcoded secrets (Gitleaks)"
                echo "=========================================="
                // Start clean so a failed build never archives reports from an earlier run
                sh 'rm -rf "$REPORTS_DIR" && mkdir -p "$REPORTS_DIR"'
                // Always enforced: a leaked secret fails the build before anything is built
                sh 'bash scripts/ci/secrets-scan.sh'
            }
        }

        stage('Build Backend') {
            steps {
                echo "=========================================="
                echo "STEP 1: Building Spring Boot Application"
                echo "=========================================="
                dir('app/backend/backend-java') {
                    sh '''
                        echo "Running Maven clean package..."
                        mvn -B clean package -DskipTests
                        
                        echo ""
                        echo "Build artifacts:"
                        ls -lh target/*.jar | tail -5
                        echo "✓ Build successful"
                    '''
                }
            }
        }
        
        stage('Run Unit Tests') {
            steps {
                echo "=========================================="
                echo "STEP 2: Running Unit Tests"
                echo "=========================================="
                dir('app/backend/backend-java') {
                    sh '''
                        echo "Running Maven test suite..."
                        mvn -B test
                        echo "✓ Tests passed"
                    '''
                }
            }
        }

        stage('Security Scan (SAST)') {
            steps {
                echo "=========================================="
                echo "Static security analysis (SpotBugs + FindSecBugs)"
                echo "=========================================="
                script {
                    // Analyses the classes compiled in 'Build Backend'
                    def status = sh(returnStatus: true, script: 'bash scripts/ci/sast.sh')
                    if (status == 2) {
                        error('SAST could not run: no compiled classes, see the stage log')
                    }
                    if (status != 0) {
                        def message = 'Security bugs found by SpotBugs, see spotbugs-report.xml'
                        if (env.ENFORCE_SAST == 'true') {
                            error(message)
                        }
                        unstable(message)
                    }
                }
            }
        }

        stage('Dependency Scan') {
            steps {
                echo "=========================================="
                echo "Scanning dependencies for known vulnerabilities (Trivy)"
                echo "=========================================="
                script {
                    // Exit 1 = fixable vulnerabilities found, 2 = the scan itself failed
                    def status = sh(returnStatus: true, script: 'bash scripts/ci/dependency-scan.sh')
                    if (status == 2) {
                        error('Dependency scan failed to run, see the stage log')
                    }
                    if (status != 0) {
                        def message = 'Dependencies with fixable vulnerabilities, see trivy-report.html'
                        if (env.ENFORCE_DEPENDENCY_SCAN == 'true') {
                            error(message)
                        }
                        unstable(message)
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "=========================================="
                echo "STEP 3: SonarQube Analysis & Quality Gate"
                echo "=========================================="
                dir('app/backend/backend-java') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh 'mvn -B sonar:sonar -Dsonar.token=$SONAR_TOKEN -Dsonar.qualitygate.wait=true'
                    }
                }
            }
        }
        
        stage('Verify JPA Entities') {
            steps {
                echo "=========================================="
                echo "STEP 4: Verify JPA Entity Configuration"
                echo "=========================================="
                dir('app/backend/backend-java') {
                    sh '''
                        echo "Checking for JPA entity annotations..."
                        
                        ENTITY_CHECK=$(grep -r "@Entity" src/main/java/com/neueda/leap/models/ 2>/dev/null | wc -l)
                        echo "  -> Found $ENTITY_CHECK @Entity annotations"
                        
                        REPO_CHECK=$(grep -r "extends JpaRepository" src/main/java/com/neueda/leap/repositories/ 2>/dev/null | wc -l)
                        echo "  -> Found $REPO_CHECK JPA repositories"
                        
                        if [ $ENTITY_CHECK -gt 0 ] && [ $REPO_CHECK -gt 0 ]; then
                            echo "✓ JPA configuration verified"
                        else
                            echo "⚠ Warning: Some JPA entities may be missing annotations"
                        fi
                    '''
                }
            }
        }
    }
    
    post {
        always {
            echo "=========================================="
            echo "Collecting Build Artifacts"
            echo "=========================================="
            dir('app/backend/backend-java') {
                sh '''
                    echo "Build Summary:"
                    if [ -f target/team-skeleton.jar ]; then
                        SIZE=$(du -h target/team-skeleton.jar | cut -f1)
                        echo "  ✓ JAR built: $SIZE"
                    fi
                    
                    if [ -d target/surefire-reports ]; then
                        TEST_COUNT=$(find target/surefire-reports -name "*.xml" | wc -l)
                        echo "  ✓ Test reports: $TEST_COUNT"
                    fi
                '''
            }

            // Keep the security reports with the build before the workspace is cleaned
            archiveArtifacts artifacts: "${REPORTS_DIR}/**", allowEmptyArchive: true

            cleanWs(deleteDirs: true, patterns: [[pattern: '**/target/**', type: 'INCLUDE']])
        }
        
        failure {
            echo "=========================================="
            echo "APPLICATION BUILD PIPELINE FAILED"
            echo "=========================================="
        }
        
        success {
            echo "=========================================="
            echo "APPLICATION BUILD PIPELINE SUCCESSFUL"
            echo "Build Number: ${BUILD_NUMBER}"
            echo "=========================================="
        }
    }
}
